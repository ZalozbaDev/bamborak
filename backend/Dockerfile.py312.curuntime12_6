# ==============================
# Stage 1 – Builder
# ==============================
FROM nvidia/cuda:12.6.2-devel-ubuntu24.04 AS bamborak_cuda_builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /opt/build

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    git pkgconf \
    libavformat-dev libavcodec-dev libavdevice-dev \
    libavutil-dev libavfilter-dev libswscale-dev libswresample-dev \
    ffmpeg \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# venv außerhalb vom App-Ordner (bessere Cachebarkeit)
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# ---- Python Dependencies zuerst kopieren (Cache!)
COPY requirements.txt /
RUN pip install -r /requirements.txt

# ==============================
# Stage 2 – Runtime (minimal!)
# ==============================
FROM nvidia/cuda:12.6.2-runtime-ubuntu24.04

LABEL com.nvidia.cuda.version="12.6"
LABEL license="Includes NVIDIA CUDA redistributables subject to NVIDIA EULA"

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /usr/app/src

# nur Runtime-Libraries (KEINE dev!)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    libsndfile1 sox libsox-fmt-all \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# venv vom Builder übernehmen
COPY --from=bamborak_cuda_builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# App-Code zuletzt kopieren → C++ Rebuild nur bei Codeänderung
COPY . .

RUN mkdir -p logs temp tts_models voice_changer config

EXPOSE 8080

RUN chmod 755 start.sh

CMD ["./start.sh", "logs"]
